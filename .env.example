# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key (server-side only)

# App
NEXT_PUBLIC_APP_URL=https://katrajpune.com
NEXT_PUBLIC_MAP_CENTER_LAT=18.4593
NEXT_PUBLIC_MAP_CENTER_LNG=73.8456
NEXT_PUBLIC_MAP_ZOOM=13

# Meta Graph API (Facebook Page & Instagram Professional Feed Auto-Posting)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# LinkedIn API (Personal Profile or Company Page Auto-Posting)
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token
LINKEDIN_AUTHOR_URN=urn:li:organization:your_organization_id
